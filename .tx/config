# Workflow: backend extract, pull and compile
# Requires an authenticated Transifex CLI.
# 1) $ cd "$(git rev-parse --show-toplevel)"
# 2) $ pybabel extract -F pyproject.toml -o invenio_saml/translations/messages.pot invenio_saml
# 3) $ tx pull -a
# 4) $ pybabel compile -d invenio_saml/translations

# Optional workflow: push extracted sources
# 1) $ cd "$(git rev-parse --show-toplevel)"
# 2) $ tx push -s

# Optional workflow: new backend language
# 1) $ cd "$(git rev-parse --show-toplevel)"
# 2) $ pybabel init -i invenio_saml/translations/messages.pot -d invenio_saml/translations -l <lang>
# 3) Translate the PO file, then compile:
#    $ pybabel compile -d invenio_saml/translations -l <lang>

[main]
host = https://app.transifex.com

[o:inveniosoftware:p:invenio:r:invenio-saml-messages]
file_filter = invenio_saml/translations/<lang>/LC_MESSAGES/messages.po
source_file = invenio_saml/translations/messages.pot
source_lang = en
type = PO
